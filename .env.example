# Copy this file to .env and fill in the keys for whichever provider you
# want to use. The app also works with NOTHING set — it falls back to a
# deterministic template-based generator so the demo still runs end to end.

# Option A: Anthropic (Claude)
ANTHROPIC_API_KEY=


HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional: force a specific provider instead of auto-detecting from the
# keys above. One of: anthropic | huggingface | template
GENERATION_PROVIDER=
